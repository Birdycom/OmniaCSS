{
  "name": "omniacss-workspace",
  "version": "0.12.4",
  "private": true,
  "description": "OmniaCSS monorepo: utilities and tokens (@birdycom/omniacss), CLI (@birdycom/omniacss-cli), Tailwind migration (@birdycom/omniacss-migrate) and the CSS documentation site. Components and blocks live in the OmniaUI repo.",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/migrate",
    "packages/mcp",
    "apps/docs"
  ],
  "scripts": {
    "test": "npm run build && npm test -w @birdycom/omniacss-cli -w @birdycom/omniacss-migrate && npm run vscode:build && npm run build -w @birdycom/omniacss-mcp && npm test -w @birdycom/omniacss-mcp",
    "sass": "sass --watch src/scss/:src/css/ --source-map",
    "sass:build:colors": "sass src/scss/omnia_colors.scss src/css/oc-colors.css --source-map --embed-sources",
    "sass:build": "npm run sass:build:colors && sass src/scss/omnia_main.scss src/css/omnia_main.css --source-map --embed-sources",
    "sass:build:hsl": "sass src/scss/profiles/omnia_main.hsl.scss src/css/omnia_main.hsl.css --source-map",
    "sass:build:oklch": "sass src/scss/profiles/omnia_main.oklch.scss src/css/omnia_main.oklch.css --source-map",
    "sass:build:oklab": "sass src/scss/profiles/omnia_main.oklab.scss src/css/omnia_main.oklab.css --source-map",
    "json": "json-to-scss src/scss/json/Omnia-colors.json",
    "htmljson": "json-to-scss src/scss/json/html-colors.json  ",
    "raljson": "json-to-scss src/scss/json/ral-colors.json  ",
    "colors:properties": "node scripts/build-color-properties.mjs",
    "eol:css": "node scripts/normalize-css-eol.mjs",
    "compat:build": "node scripts/build-browser-support.mjs",
    "assets:bust": "node scripts/cache-bust-assets.mjs",
    "code-syntax-theme": "node scripts/build-code-syntax-theme.mjs",
    "basic": "postcss src/css/omnia_main.css --output public/css/omnia_main.css --env development --config ./config/ --verbose",
    "basicp": "postcss src/css/omnia_main.css --output public/css/omnia_main.min.css --env production --config ./config/ --verbose --no-map",
    "nano": "cssnano public/css/omnia_main.css public/css/omnia_main.min.css",
    "css:dev:colors": "postcss src/css/oc-colors.css --output public/css/oc-colors.css --env development --config ./config/ --verbose",
    "css:dev": "npm run css:dev:colors && postcss src/css/omnia_main.css --output public/css/omnia_main.css --env development --config ./config/ --verbose",
    "css:watch": "postcss src/css/omnia_main.css --output public/css/omnia_main.css --env development --config ./config/ --verbose --watch",
    "css:build:colors": "postcss src/css/oc-colors.css --output public/css/oc-colors.min.css --env production --config ./config/ --verbose --no-map",
    "css:build": "npm run css:build:colors && postcss src/css/omnia_main.css --output public/css/omnia_main.min.css --env production --config ./config/ --verbose --no-map",
    "css:dev:hsl": "postcss src/css/omnia_main.hsl.css --output public/css/omnia_main.hsl.css --env development --config ./config/ --verbose",
    "css:dev:oklch": "postcss src/css/omnia_main.oklch.css --output public/css/omnia_main.oklch.css --env development --config ./config/ --verbose",
    "css:dev:oklab": "postcss src/css/omnia_main.oklab.css --output public/css/omnia_main.oklab.css --env development --config ./config/ --verbose",
    "css:build:hsl": "postcss src/css/omnia_main.hsl.css --output public/css/omnia_main.hsl.min.css --env production --config ./config/ --verbose --no-map",
    "css:build:oklch": "postcss src/css/omnia_main.oklch.css --output public/css/omnia_main.oklch.min.css --env production --config ./config/ --verbose --no-map",
    "css:build:oklab": "postcss src/css/omnia_main.oklab.css --output public/css/omnia_main.oklab.min.css --env production --config ./config/ --verbose --no-map",
    "build": "npm run sass:build && npm run css:dev && npm run css:build && npm run colors:properties && npm run eol:css && npm run build:packages && npm run compat:build && npm run docs:build",
    "build:hsl": "npm run sass:build:hsl && npm run css:dev:hsl && npm run css:build:hsl",
    "build:oklch": "npm run sass:build:oklch && npm run css:dev:oklch && npm run css:build:oklch",
    "build:oklab": "npm run sass:build:oklab && npm run css:dev:oklab && npm run css:build:oklab",
    "dev": "npm run sass:build && npm run css:dev",
    "start": "npm run dev",
    "build:packages": "node scripts/build-packages.mjs",
    "release": "node scripts/release.mjs",
    "docs:dev": "npm run dev --workspace apps/docs",
    "docs:build": "node scripts/sync-omniaui.mjs && npm run build --workspace apps/docs && node scripts/sync-site.mjs && npm run assets:bust && node scripts/clean-urls.mjs",
    "docs:check": "node apps/docs/scripts/check-pages.mjs",
    "sync:omniaui": "node scripts/sync-omniaui.mjs",
    "vscode:build": "npm run build --prefix packages/vscode",
    "vscode:test": "npm run build --prefix packages/vscode && npm test --prefix packages/vscode",
    "vscode:package": "npm run package --prefix packages/vscode",
    "deploy": "node scripts/deploy.mjs"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.2%",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Birdycom/OmniaCSS.git"
  },
  "keywords": [
    "css",
    "utility-first",
    "design-system",
    "light-dark",
    "container-queries",
    "anchor-positioning"
  ],
  "author": "Serge Cools",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Birdycom/OmniaCSS/issues"
  },
  "homepage": "https://github.com/Birdycom/OmniaCSS#readme",
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.5",
    "autoprefixer": "^10.4.21",
    "basic-ftp": "^6.2.3",
    "cssnano": "^7.1.1",
    "json-to-scss": "^1.6.2",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.1.3",
    "sass": "^1.85.1"
  }
}
