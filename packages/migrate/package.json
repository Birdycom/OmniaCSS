{
  "name": "@birdycom/omniacss-migrate",
  "version": "0.12.1",
  "description": "Switch a Laravel / Vue / React project from Tailwind CSS to OmniaCSS and keep your class names (PostCSS + Vite plugin, scan, setup, codemod), or convert a Bootstrap 3/4/5 site to OmniaCSS + OmniaUI.",
  "type": "module",
  "license": "MIT",
  "author": "Serge Cools (Birdycom)",
  "homepage": "https://omniacss.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Birdycom/OmniaCSS.git",
    "directory": "packages/migrate"
  },
  "bugs": {
    "url": "https://github.com/Birdycom/OmniaCSS/issues"
  },
  "keywords": [
    "css",
    "migration",
    "tailwind",
    "bootstrap",
    "laravel",
    "vite",
    "postcss",
    "codemod",
    "omniacss"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omniacss-migrate": "./bin/omniacss-migrate.mjs"
  },
  "exports": {
    ".": {
      "style": "./src/entry.css",
      "default": "./src/index.mjs"
    },
    "./postcss": "./src/postcss.mjs",
    "./vite": "./src/vite.mjs",
    "./cli": "./src/cli.mjs",
    "./colors.json": "./src/data/colors.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build:colors": "node scripts/build-color-map.mjs"
  },
  "dependencies": {
    "@birdycom/omniacss": "^0.12.1",
    "postcss": "^8.5.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
